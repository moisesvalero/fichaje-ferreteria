# Configuración de Appwrite. Estos valores son públicos por diseño (viajan en el
# bundle del cliente), pero el repositorio no lleva incrustado el proyecto de
# nadie: pon el tuyo.
#
# Cómo conseguir unos:
#   1. Crea un proyecto en https://cloud.appwrite.io
#   2. Añade tu dominio (y `localhost`) como plataforma Web
#   3. Activa el proveedor de Google en Auth
#   4. Aprovisiona el esquema:  AW_KEY=... node scripts/provisionar-appwrite.mjs

# Déjalo SIN definir en producción: la app llama a /appwrite de su propio dominio
# (proxy en vercel.json y en el servidor de desarrollo). Definirlo solo si quieres
# apuntar a otro endpoint.
# VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=tu_project_id
VITE_APPWRITE_DATABASE=tu_database_id
VITE_APPWRITE_COLECCION_JORNADAS=fichaje_jornadas
VITE_APPWRITE_COLECCION_AJUSTES=fichaje_ajustes
