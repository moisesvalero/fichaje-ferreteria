{
  "name": "fichaje-ferreteria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA personal para controlar las horas de trabajo: 8 h al día y 40 h a la semana, sin cuentas ni nube.",
  "keywords": [
    "pwa",
    "fichaje",
    "control-horario",
    "svelte",
    "offline",
    "indexeddb"
  ],
  "license": "MIT",
  "author": "Moisés Valero",
  "repository": {
    "type": "git",
    "url": "https://github.com/moisesvalero/fichaje-ferreteria.git"
  },
  "homepage": "https://github.com/moisesvalero/fichaje-ferreteria#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "dexie": "^4.4.6",
    "jspdf": "^4.2.1"
  }
}
